image_pull {
    Name: "alpine",
    Pull: "alpine:3.24.1",
}

image_build {
    Name: "base",
    From: ["alpine"],
}

image_build {
    Name: "hatch",
    From: ["base"],
    Input: ["idle.go"],
    PrefixDir: ".",
}

image_build {
    Name: "app",
    From: ["base"],
}

image_build {
    Name: "nodejs",
    From: ["base"],
    Input: [
        "idle.js",
        "ssh_known_hosts",
    ],
    PrefixDir: ".",
    // See https://www.npmjs.com/package/npm
    Args: ["NPM_VERSION=12.0.2"],
}

download {
    Name: "download_golang",
    URL: "https://go.dev/dl/go1.26.5.src.tar.gz",
    Checksum: "sha256:495be4bc87176ac567392e5b4116abd98466d33d7b49d41e764ccc6976b2dc42",
    Output: "go-src.tgz",
}

container_run {
    Name: "build_golang",
    Image: "hatch",
    Input: {
        "go-src.tgz": "/usr/local/go-src.tgz",
        "build-go.sh": "/root/build-go.sh",
    },
    Output: {
        "go.tgz": "/usr/local/go.tgz",
    },
    WorkDir: "/root",
    Command: ["/bin/bash", "/root/build-go.sh"],
}

image_build {
    Name: "golang",
    From: ["base"],
    Input: [
        "go.tgz",
        "ssh_known_hosts",
    ],
    PrefixDir: ".",
}

image_build {
    Name: "forge",
    From: ["golang"],
    Input: ["idle.go"],
    PrefixDir: ".",
}

image_build {
    Name: "bkgo",
    From: ["golang"],
}

bundle {
    Name: "core",
    Deps: [
        "app",
        "golang",
        "forge",
        "nodejs",
    ],
}
